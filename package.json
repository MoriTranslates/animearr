{
  "name": "animearr",
  "version": "0.10.0-nightly",
  "private": true,
  "description": "Anime-first library manager: finds, checks and imports anime (subtitle-language aware), next to or instead of Sonarr/Radarr.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite build && tsx watch server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node --no-warnings=ExperimentalWarning dist/server/index.js",
    "test": "node --no-warnings --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
